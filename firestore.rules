rules_version = '2';

// PoolD security rules.
//
// Threat model
//   - Entry content (name / age / description / photo / rating / location) is
//     confidential. Readable by the owner, and by a mutual friend ONLY when the
//     entry's own visibility == 'friends'.
//   - Friendships cannot be forged. A friendship document can only be created by
//     the recipient of a pending request addressed to them.
//   - Usernames are globally unique. Enforced by the /usernames/{handle} key space
//     plus a getAfter() cross-check against the profile, not by client goodwill.
//
// What these rules deliberately do NOT do
//   - They cannot verify that a self-reported aggregate count is arithmetically
//     true. They bound its SHAPE (type, sign, key count) only. A user can inflate
//     their own stats; no other user's data is exposed by that. See
//     src/lib/aggregates/delta.ts for the single source of truth on the numbers.
//
// Every branch here is covered by tests/rules/*.test.ts against the emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(u) {
      return signedIn() && request.auth.uid == u;
    }

    // Friendship documents are keyed by the two uids sorted, so one document is
    // one relationship and there is no possible asymmetry between directions.
    function pairKeyOf(a, b) {
      return a < b ? a + '__' + b : b + '__' + a;
    }

    // Costs one billed document read. Repeats of the same path within a single
    // evaluation are cached, and because the owner uid is fixed by the path (not
    // by resource.data) it is evaluated once per query rather than per result.
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairKeyOf(a, b)));
    }

    function isIso2(c) {
      return c is string && c.matches('^[A-Z]{2}$');
    }

    function isDateKey(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ------------------------------------------------------ private user doc

    match /users/{userId} {

      function validUser(d) {
        return d.keys().hasAll(['email', 'createdAt', 'settings', 'schemaVersion'])
            && d.keys().hasOnly([
                 'email', 'authProviders', 'createdAt', 'usernameChangedAt',
                 'settings', 'friendUidsCache', 'deletion', 'schemaVersion'
               ])
            && d.email is string
            && d.email == request.auth.token.email
            && d.settings is map
            && d.settings.defaultVisibility in ['private', 'friends']
            && d.settings.encounterCoverageMode in ['hidden', 'sharedOnly', 'all']
            // Mirror of the friendships collection, for rendering only. NO rule
            // anywhere reads this, so a stale or tampered value cannot grant access.
            && (!('friendUidsCache' in d)
                || (d.friendUidsCache is list && d.friendUidsCache.size() <= 500))
            && d.schemaVersion is int;
      }

      allow get, list: if isSelf(userId);

      allow create: if isSelf(userId)
                    && validUser(request.resource.data)
                    && request.resource.data.createdAt == request.time;

      allow update: if isSelf(userId)
                    && validUser(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSelf(userId);

      // Read by rules via exists() (rule reads bypass rules) and by the owner's UI.
      match /blocked/{otherUid} {
        allow read, write: if isSelf(userId);
      }

      // docId is 'private' (owner only) or 'public' (owner + mutual friends).
      match /aggregates/{docId} {

        function boundedMap(m, maxKeys) {
          return m is map && m.keys().size() <= maxKeys;
        }

        // Every read is guarded. An unguarded `d.someField` throws an evaluation error
        // rather than returning false when the field is absent, which turns a partial
        // write into an opaque rejection instead of a clean deny.
        function validPrivateAgg(d) {
          return d.keys().hasOnly([
                   'totalEntries', 'countryCountsAll', 'countryCountsShared',
                   'nationalityCounts', 'metViaCounts', 'ratingSum', 'ratingCount',
                   'ratingSumShared', 'ratingCountShared', 'unresolvedCount',
                   'firstEntryDateKey', 'lastEntryDateKey', 'updatedAt'
                 ])
              // increment() results are visible here as the post-write value, so
              // these bounds genuinely constrain the outcome rather than the delta.
              && (!('totalEntries' in d) || (d.totalEntries is int && d.totalEntries >= 0))
              && (!('countryCountsAll' in d) || boundedMap(d.countryCountsAll, 320))
              && (!('countryCountsShared' in d) || boundedMap(d.countryCountsShared, 320))
              && (!('nationalityCounts' in d) || boundedMap(d.nationalityCounts, 320))
              && (!('metViaCounts' in d) || boundedMap(d.metViaCounts, 40))
              && (!('ratingSum' in d) || (d.ratingSum is int && d.ratingSum >= 0))
              && (!('ratingCount' in d) || (d.ratingCount is int && d.ratingCount >= 0))
              && (!('unresolvedCount' in d)
                  || (d.unresolvedCount is int && d.unresolvedCount >= 0));
        }

        function validPublicAgg(d) {
          return d.keys().hasOnly([
                   'visitedManual', 'visitedCodes', 'encounterCoverageMode',
                   'countryCounts', 'encounterTotal', 'avgRatingPublished', 'updatedAt'
                 ])
              && (!('visitedManual' in d) || boundedMap(d.visitedManual, 320))
              && (!('visitedCodes' in d)
                  || (d.visitedCodes is list && d.visitedCodes.size() <= 320))
              && (!('encounterCoverageMode' in d)
                  || d.encounterCoverageMode in ['hidden', 'sharedOnly', 'all'])
              && (!('countryCounts' in d) || boundedMap(d.countryCounts, 320))
              && (!('encounterTotal' in d)
                  || (d.encounterTotal is int && d.encounterTotal >= 0));
        }

        // docId is a PATH variable, so it is statically known and a friend's
        // get() on .../aggregates/public is satisfiable without reading the doc.
        allow get: if isSelf(userId)
                   || (docId == 'public' && signedIn() && areFriends(userId, request.auth.uid));

        // Never friend-listable: the friend branch depends on docId, which a
        // collection query cannot constrain, so it could only ever deny.
        allow list: if isSelf(userId);

        allow create, update: if isSelf(userId)
                              && docId in ['private', 'public']
                              && request.resource.data.updatedAt == request.time
                              && (docId == 'private'
                                    ? validPrivateAgg(request.resource.data)
                                    : validPublicAgg(request.resource.data));

        allow delete: if isSelf(userId);
      }

      match /encounters/{entryId} {

        function validEntry(d) {
          return d.keys().hasAll([
                   'ownerUid', 'visibility', 'location', 'countryCode',
                   'countryStatus', 'name', 'date', 'dateKey', 'rating',
                   'createdAt', 'updatedAt', 'schemaVersion'
                 ])
              && d.keys().hasOnly([
                   'ownerUid', 'visibility', 'location', 'countryCode', 'countryName',
                   'countryNumeric', 'continent', 'subregion', 'countryStatus',
                   'nationalityCode', 'nationalityLabel', 'name', 'age', 'metVia',
                   'metViaDetail', 'date', 'dateKey', 'description', 'rating', 'tags',
                   'photo', 'hasFullPhoto', 'createdAt', 'updatedAt', 'schemaVersion'
                 ])
              && d.ownerUid == userId
              && d.visibility in ['private', 'friends']

              && d.location is map
              && d.location.keys().hasOnly(['lat', 'lng', 'label', 'source', 'accuracyKm'])
              && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
              && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180
              && d.location.label is string && d.location.label.size() <= 160

              // 'XX' unresolved, 'XZ' international waters, otherwise ISO alpha-2.
              && isIso2(d.countryCode)
              && d.countryStatus in ['contains', 'nearest', 'manual', 'unresolved']
              && (!('nationalityCode' in d) || isIso2(d.nationalityCode))

              && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
              // Policy floor, enforced server-side rather than only in the form.
              && (!('age' in d) || d.age == null
                  || (d.age is int && d.age >= 18 && d.age <= 99))
              && (!('metViaDetail' in d) || d.metViaDetail == null
                  || (d.metViaDetail is string && d.metViaDetail.size() <= 60))

              && d.date is timestamp
              && isDateKey(d.dateKey)
              && d.rating is int && d.rating >= 1 && d.rating <= 10
              && (!('description' in d)
                  || (d.description is string && d.description.size() <= 2000))
              // Rules cannot iterate a list, so bound the joined length instead.
              && (!('tags' in d)
                  || (d.tags is list && d.tags.size() <= 12
                      && d.tags.join('|').size() <= 300))

              && (!('photo' in d) || d.photo == null
                  || (d.photo is map
                      && d.photo.keys().hasOnly(['thumbDataUrl', 'w', 'h', 'bytes'])
                      && d.photo.thumbDataUrl is string
                      && d.photo.thumbDataUrl.size() <= 48000))

              && d.createdAt is timestamp
              && d.updatedAt is timestamp
              && d.schemaVersion is int;
        }

        // The owner branch needs no resource.data, so an owner's queries are
        // unconstrained. For a friend the owner branch is false, so the engine
        // must prove visibility == 'friends' from the query itself, which means
        // the client MUST include where('visibility','==','friends') or the whole
        // query is rejected. See src/services/encounters.ts.
        allow get: if isSelf(userId)
                   || (signedIn()
                       && resource.data.visibility == 'friends'
                       && areFriends(userId, request.auth.uid));

        allow list: if isSelf(userId)
                    || (signedIn()
                        && resource.data.visibility == 'friends'
                        && areFriends(userId, request.auth.uid));

        allow create: if isSelf(userId)
                      && validEntry(request.resource.data)
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if isSelf(userId)
                      && validEntry(request.resource.data)
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.updatedAt == request.time;

        allow delete: if isSelf(userId);

        match /media/{mediaId} {

          function parentVisibility() {
            return get(/databases/$(database)/documents/users/$(userId)/encounters/$(entryId))
                     .data.visibility;
          }

          // Costs 2 rule reads for a friend (parent entry + friendship). Worth it:
          // the alternative is duplicating the visibility flag onto the media doc
          // and trusting the copy to stay in step with the parent.
          allow get: if isSelf(userId)
                     || (signedIn()
                         && parentVisibility() == 'friends'
                         && areFriends(userId, request.auth.uid));

          allow list: if isSelf(userId);

          allow create, update: if isSelf(userId)
                        && mediaId == 'full'
                        && request.resource.data.keys().hasOnly([
                             'dataUrl', 'w', 'h', 'bytes', 'mime', 'createdAt'
                           ])
                        && request.resource.data.dataUrl is string
                        // The 1 MiB document cap covers field names and overhead.
                        // Client targets <= 700_000; this is the hard stop.
                        && request.resource.data.dataUrl.size() <= 750000
                        && request.resource.data.mime in ['image/jpeg', 'image/webp']
                        && request.resource.data.createdAt == request.time;

          allow delete: if isSelf(userId);
        }
      }
    }

    // -------------------------------------------------------- public profiles
    // Readable by any signed-in user, because that is what username search
    // requires. Therefore it must contain nothing sensitive: no email, no counts,
    // no country data. Enumerating this collection must be harmless.

    match /publicProfiles/{userId} {

      function validProfile(d) {
        return d.keys().hasAll([
                 'uid', 'username', 'usernameLower', 'displayName',
                 'displayNameLower', 'joinedAt', 'updatedAt'
               ])
            && d.keys().hasOnly([
                 'uid', 'username', 'usernameLower', 'displayName', 'displayNameLower',
                 'avatarThumb', 'avatarUrl', 'joinedAt', 'deleted', 'updatedAt'
               ])
            && d.uid == userId
            && d.username is string
            && d.username.matches('^[A-Za-z0-9_]{3,20}$')
            // Making the lowercase invariant server-enforced is what stops 'Bob'
            // and 'bob' from claiming two different handles.
            && d.usernameLower == d.username.lower()
            && d.displayName is string
            && d.displayName.size() >= 1 && d.displayName.size() <= 40
            && d.displayNameLower == d.displayName.lower()
            && (!('avatarThumb' in d) || d.avatarThumb == null
                || (d.avatarThumb is string && d.avatarThumb.size() <= 24000))
            && (!('avatarUrl' in d) || d.avatarUrl == null
                || (d.avatarUrl is string && d.avatarUrl.matches('^https://.*')
                    && d.avatarUrl.size() <= 512))
            && (!('deleted' in d) || d.deleted is bool)
            && d.updatedAt == request.time;
      }

      // The handle claim must point back at this user AFTER the write. Combined
      // with the /usernames create rule, the two documents can only ever agree.
      function claimsHandle(d) {
        return getAfter(/databases/$(database)/documents/usernames/$(d.usernameLower))
                 .data.uid == userId;
      }

      allow get: if signedIn();

      // The limit ceiling blocks bulk directory scraping. NOTE: a query with no
      // limit() leaves request.query.limit null and is therefore DENIED — every
      // publicProfiles query in the client must call .limit().
      allow list: if signedIn() && request.query.limit <= 25;

      allow create: if isSelf(userId)
                    && validProfile(request.resource.data)
                    && request.resource.data.joinedAt == request.time
                    && claimsHandle(request.resource.data);

      allow update: if isSelf(userId)
                    && validProfile(request.resource.data)
                    && request.resource.data.joinedAt == resource.data.joinedAt
                    && claimsHandle(request.resource.data);

      allow delete: if isSelf(userId);
    }

    // ------------------------------------------------------------- usernames

    match /usernames/{handle} {

      function profileClaims() {
        return getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
                 .data.usernameLower == handle;
      }

      // get() powers the live availability check. list() is denied so the
      // handle -> uid map cannot be dumped wholesale.
      allow get: if signedIn();
      allow list: if false;

      // A claim on an EXISTING handle arrives as an update (setDoc sends no
      // precondition) and update-by-a-stranger is denied, which is what makes the
      // key space enforce uniqueness. The client additionally wraps this in a
      // transaction whose read set includes the missing document, so concurrent
      // claimants are serialised rather than racing.
      allow create: if signedIn()
                    && handle.matches('^[a-z0-9_]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid', 'claimedAt', 'releasedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.claimedAt == request.time
                    && profileClaims();

      // Tombstone rather than free instantly: 30 days of squatter protection so a
      // just-released handle cannot be grabbed to impersonate its former owner.
      // The reservation window itself is enforced in the client transaction; the
      // rule only guarantees that nobody but the owner can tombstone.
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['releasedAt'])
                    && request.resource.data.releasedAt == request.time;

      // Hard delete only during an account purge, once the profile no longer
      // claims the handle. This is what forces the correct purge ordering.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------- friend requests

    match /friendRequests/{reqId} {

      function senderProfile() {
        return get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
      }

      allow get: if signedIn()
                 && (request.auth.uid == resource.data.fromUid
                     || request.auth.uid == resource.data.toUid);

      // A disjunction becomes satisfiable as soon as ONE branch is proven by the
      // query: where('toUid','==',me) proves branch 1, where('fromUid','==',me)
      // proves branch 2. A query constraining neither is rejected.
      allow list: if signedIn()
                  && (resource.data.toUid == request.auth.uid
                      || resource.data.fromUid == request.auth.uid);

      allow create: if signedIn()
                    && reqId == request.auth.uid + '__' + request.resource.data.toUid
                    && request.resource.data.keys().hasOnly([
                         'fromUid', 'toUid', 'status', 'createdAt', 'respondedAt',
                         'message', 'fromUsername', 'fromDisplayName', 'fromAvatarThumb'
                       ])
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time
                    && (!('message' in request.resource.data)
                        || request.resource.data.message == null
                        || request.resource.data.message.size() <= 140)
                    // Anti-impersonation: the denormalised sender identity shown in
                    // the recipient's inbox must match the sender's real profile.
                    && request.resource.data.fromUsername == senderProfile().username
                    && request.resource.data.fromDisplayName == senderProfile().displayName
                    && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid))
                    && !areFriends(request.auth.uid, request.resource.data.toUid)
                    && !exists(/databases/$(database)/documents/users/$(request.resource.data.toUid)/blocked/$(request.auth.uid));

      // Only the recipient may decline, only pending -> declined, only those two
      // fields. Accepting is NOT an update: it is a batch of
      // { create(friendship), delete(request) } — see /friendships below.
      allow update: if signedIn()
                    && request.auth.uid == resource.data.toUid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'declined'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'respondedAt'])
                    && request.resource.data.respondedAt == request.time;

      // Sender delete == cancel. Recipient delete == accept-consume, or dismiss.
      allow delete: if signedIn()
                    && (request.auth.uid == resource.data.fromUid
                        || request.auth.uid == resource.data.toUid);
    }

    // ------------------------------------------------------------ friendships

    match /friendships/{pairKey} {

      function counterpart(uids) {
        return uids[0] == request.auth.uid ? uids[1] : uids[0];
      }

      allow get: if signedIn() && request.auth.uid in resource.data.uids;

      // Satisfied by where('uids', 'array-contains', myUid).
      allow list: if signedIn() && request.auth.uid in resource.data.uids;

      // Forgery is closed off here: only the RECIPIENT of a PENDING request from
      // the counterpart can create the friendship. Inside a batched write, get()
      // observes pre-batch state, so the request still reads 'pending' even though
      // the same batch deletes it.
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uids', 'initiatorUid', 'createdAt'])
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.auth.uid in request.resource.data.uids
                    && request.resource.data.uids[0] < request.resource.data.uids[1]
                    && pairKey == request.resource.data.uids[0] + '__' + request.resource.data.uids[1]
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.initiatorUid == counterpart(request.resource.data.uids)
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.initiatorUid + '__' + request.auth.uid)).data.status == 'pending';

      // Immutable: nothing about a friendship can be edited after the fact.
      allow update: if false;

      // Either participant may unfriend, and one delete revokes both directions.
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    // Everything not matched above is denied. Deliberately no recursive
    // /users/{uid}/{doc=**} wildcard anywhere in this file.
  }
}
