{
  "name": "poold",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:countries": "node scripts/gen-countries.mjs",
    "emu": "firebase emulators:start --only auth,firestore --project poold-d8f26",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project poold-test \"vitest run --project rules\"",
    "e2e": "node scripts/e2e.mjs",
    "verify:pages": "BASE_PATH=/TripPoolD/ npm run build && node scripts/verify-pages-build.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "firebase": "^12.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-tools": "^15.24.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "world-countries": "^5.1.0"
  }
}
